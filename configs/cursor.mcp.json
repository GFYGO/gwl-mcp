{
  "_readme": "Cursor：写到项目根目录 .cursor/mcp.json（或 Settings → MCP → Add Server 粘贴本段）。",
  "mcpServers": {
    "gwl": {
      "command": "<PYTHON_EXE>",
      "args": [
        "<V1_DIR>/run.py",
        "--transport",
        "stdio"
      ],
      "cwd": "<V1_DIR>",
      "env": {
        "GWL_USER_ID": "<GWL_USER_ID>",
        "GWL_API_KEY": "<GWL_API_KEY>",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "gwl-http": {
      "_readme": "本地 Streamable HTTP：先 python run.py --transport http，再把令牌换成 GWL_HTTP_AUTH_TOKEN。",
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp",
      "headers": {
        "Authorization": "Bearer <GWL_HTTP_AUTH_TOKEN>"
      }
    }
  }
}
