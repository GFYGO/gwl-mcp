{
  "_readme": "VS Code / Copilot：项目根目录 .vscode/mcp.json（Outputs 面板可看连接日志）。",
  "servers": {
    "gwl": {
      "type": "stdio",
      "command": "<PYTHON_EXE>",
      "args": [
        "<V1_DIR>/run.py",
        "--transport",
        "stdio"
      ],
      "cwd": "<V1_DIR>",
      "env": {
        "GWL_USER_ID": "<GWL_USER_ID>",
        "GWL_API_KEY": "<GWL_API_KEY>",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "gwl-http": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp",
      "headers": {
        "Authorization": "Bearer <GWL_HTTP_AUTH_TOKEN>"
      }
    }
  }
}
