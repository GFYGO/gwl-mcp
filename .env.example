# GWL MCP 服务（v1）环境变量模板
#
# 用法一（推荐，MCP 客户端里直接写 env）：把下面两项填进客户端配置的 env 字段。
# 用法二（本机跑服务）：复制成 .env（本目录），或用 GWL_ENV_FILE 指向它，然后
#     python run.py --env-file .env
#
# ⚠️ 不要把填了真实 key 的文件提交进 git：本目录 .gitignore 已排除 .env / .env.*。
# ⚠️ 密钥泄露后去 GWL 仪表盘「设置 - API Key」轮换，旧 key 立即失效。

# ---- 必填：身份 ----
# GWL 的数字用户 id（仪表盘设置页可见）
GWL_USER_ID=12
# 形如 gk_ + 43 个字符；长度必须在 16~200 之间（与上游闸门一致）
GWL_API_KEY=gk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 可选：上游地址 ----
# 默认线上；本地联调写 http://127.0.0.1:5000/api/v1，并必须显式允许 http
# GWL_API_BASE=https://back.gwl.net.cn/api/v1
# GWL_ALLOW_HTTP=0

# ---- 可选：以某个组类身份发请求（3 位字母；不会因此提权）----
# GWL_ORG_CLASS=

# ---- 可选：超时 / 重试 ----
# 单次上游请求超时（秒，1~120）
# GWL_TIMEOUT=20
# 单次工具调用（含全部重试与退避）的总墙钟预算（秒，5~300，且 >= GWL_TIMEOUT）
# GWL_TOTAL_TIMEOUT=60
# 额外重试次数（0~5）；429 任何方法都重试，5xx/网络错误只重放 GET
# GWL_MAX_RETRIES=2

# ---- 可选：安全开关 ----
# 0 = 只读模式：所有写工具（创建/更新/删除/审批/拉黑/改标签/标记已读）直接报错
# GWL_ENABLE_WRITES=1
# DEBUG / INFO / WARNING / ERROR / CRITICAL（日志只写 stderr）
# GWL_LOG_LEVEL=WARNING

# ---- 可选：Streamable HTTP / SSE 服务端 ----
# 默认只绑回环；绑 0.0.0.0 或非回环地址时必须设置访问令牌
# GWL_HTTP_HOST=127.0.0.1
# GWL_HTTP_PORT=8765
# GWL_HTTP_PATH=/mcp
# 保护 MCP 端点本身（不是 GWL API Key），至少 16 个字符。
# 客户端用 Authorization: Bearer <token> 或 X-MCP-Token: <token> 发送。
# GWL_HTTP_AUTH_TOKEN=
# 额外允许的浏览器 Origin（逗号分隔；SDK 的 allowed_origins 是精确匹配，端口也要写全）
# GWL_HTTP_ALLOWED_ORIGINS=http://localhost:6274,http://127.0.0.1:6274
# 会话空闲回收（秒，60~86400）
# GWL_HTTP_SESSION_TTL=1800
# 请求体上限（MB，1~64）
# GWL_HTTP_MAX_BODY_MB=16
# 1 = POST 一律用 application/json 回应，不升级 SSE（反代会缓冲 SSE 时更稳）
# GWL_HTTP_JSON_RESPONSE=0
# 仅在明确知道风险时，允许非回环绑定且不带访问令牌（不推荐）
# GWL_HTTP_ALLOW_INSECURE=0

# ---- 指向 .env 文件本身（可选）----
# GWL_ENV_FILE=
